# Copy to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches docker-compose.yml
DATABASE_URL=postgres://rmi:rmi@localhost:5432/rmi
REDIS_URL=redis://localhost:6379/0

# Next.js frontend origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email (Mailpit catches everything locally: http://localhost:8025)
EMAIL_URL=smtp://localhost:1025
DEFAULT_FROM_EMAIL=RMI <no-reply@rmi.local>
